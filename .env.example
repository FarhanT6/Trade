# ---- Runtime mode ----
# simulation = deterministic synthetic market (no keys needed)
# live       = real adapters (requires the keys below)
MODE=simulation
PORT=4000

# ---- Ground truth: chain / DEX ----
SOLANA_RPC_URLS=https://api.mainnet-beta.solana.com
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# ---- Social (official APIs only) ----
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=meme-intel/0.1

# ---- Discovery platforms (official/licensed access only) ----
FOMO_API_BASE_URL=
FOMO_API_KEY=
AXIOM_API_BASE_URL=
AXIOM_API_KEY=
FOMP_API_BASE_URL=

# ---- LLM (explanations / classification only, never the sole signal) ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# ---- Storage ----
DATABASE_URL=postgres://meme:meme@localhost:5432/meme_intel
REDIS_URL=redis://localhost:6379

# ---- Live on-chain execution (Solana via Jupiter). ALL gates must pass or trading stays on paper. ----
# 1. MODE=live above.  2. A small dedicated hot wallet.  3. Both flags below.  4. Caps.
LIVE_EXECUTION_ENABLED=false
LIVE_EXECUTION_ACK=              # must be exactly: I-ACCEPT-TOTAL-LOSS
SOLANA_PRIVATE_KEY=              # base58 secret key or JSON byte array of the HOT wallet only
# SOLANA_KEYPAIR_PATH=~/.config/solana/hot.json
LIVE_MAX_TRADE_USD=50
LIVE_DAILY_CAP_USD=250
LIVE_MIN_WALLET_SOL=0.05
LIVE_MAX_WALLET_SOL=50           # refuse to arm against a wallet larger than this
LIVE_SLIPPAGE_BPS=300
LIVE_MAX_PRIORITY_FEE_LAMPORTS=2000000
LIVE_ALLOWED_DEXES=              # optional comma list, e.g. Raydium,Orca,Meteora,Pump.fun
JUPITER_SWAP_BASE_URL=           # default https://lite-api.jup.ag/swap/v1
JUPITER_PRICE_BASE_URL=          # default https://lite-api.jup.ag/price/v3
JUPITER_API_KEY=
